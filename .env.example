# Put these in Vercel → Project → Settings → Environment Variables (never in the code or in GitHub)

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # the "anon / public" key (NOT the service_role key!)

# Movie data (IMDb data) — free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Optional extra source (trending + trailers): https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Jarvis (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional
GEMINI_MODEL=gemini-2.5-flash
OWNER_NAME=Himanshu
JARVIS_SEARCH=0                     # 1 = let Jarvis use Google Search for brand-new releases
